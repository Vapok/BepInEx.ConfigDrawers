<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>BepInEx.ConfigDrawers</AssemblyName>
    <RootNamespace>BepInEx.ConfigDrawers</RootNamespace>
    <Version>1.0.2</Version>
    <PackageId>BepInEx_ConfigDrawers</PackageId>
    <ReferencesRoot Condition="'$(ReferencesRoot)' == ''">/home/vapok/Modding/References</ReferencesRoot>
    <BEPINEX_CORE>$(ReferencesRoot)/BepInEx/5.4.2350/BepInEx/core</BEPINEX_CORE>
    <UNITY_MANAGED>$(ReferencesRoot)/Valheim/1.0.15/Managed</UNITY_MANAGED>
    <ReleaseRoot Condition="'$(ReleaseRoot)' == ''">/home/vapok/Modding/Releases</ReleaseRoot>
    <DevPluginsFolder Condition="'$(DevPluginsFolder)' == ''">/home/vapok/Modding/Gale Profiles/Default/BepInEx/plugins</DevPluginsFolder>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BEPINEX_CORE)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BEPINEX_CORE)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(UNITY_MANAGED)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UNITY_MANAGED)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(UNITY_MANAGED)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(UNITY_MANAGED)/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(UNITY_MANAGED)/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(UNITY_MANAGED)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(UNITY_MANAGED)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(UNITY_MANAGED)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(UNITY_MANAGED)/UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>$(UNITY_MANAGED)/UnityEngine.TextCoreFontEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Debug/Local Build: Auto-deploy to DevPluginsFolder -->
  <Target Name="CopyToDev" AfterTargets="Build" Condition="('$(Configuration)' == 'Debug' or '$(Configuration)' == 'Local') and Exists('$(DevPluginsFolder)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DevPluginsFolder)/Vapok-$(PackageId)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Release Build: Assemble store staging folder & zip package -->
  <Target Name="Copy" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <StagingDir>$(ReleaseRoot)/$(PackageId)-Vapok</StagingDir>
      <ZipOutput>$(ReleaseRoot)/$(PackageId)-Vapok-$(Version).zip</ZipOutput>
    </PropertyGroup>
    <ItemGroup>
      <PackageDocs Include="$(ProjectDir)../LICENSE.md;$(ProjectDir)../manifest.json;$(ProjectDir)../CHANGELOG.md;$(ProjectDir)../README.md;$(ProjectDir)../icon.png" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StagingDir)/plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PackageDocs)" DestinationFolder="$(StagingDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DevPluginsFolder)/Vapok-$(PackageId)" SkipUnchangedFiles="true" Condition="Exists('$(DevPluginsFolder)')" />
    <ZipDirectory SourceDirectory="$(StagingDir)" DestinationFile="$(ZipOutput)" Overwrite="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Resources/Hack-Regular.ttf" />
    <EmbeddedResource Include="Resources/Hack-Bold.ttf" />
  </ItemGroup>
</Project>
